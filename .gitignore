# ============================================================
#  notes-search — .gitignore
#  规则：代码进仓库，数据和凭证绝不进
# ============================================================

# ------------------------------------------------------------
# 1. 🔴 最重要：讲义语料（版权 + 隐私 + 体积）
# ------------------------------------------------------------
# 你的讲义是课程材料，版权属于老师/学校。
# 即使仓库是 private，也不该把别人的讲义提交进去。
# 这个目录只在你本机存在，别人 clone 后自己放自己的讲义。
notes/
!notes/.gitkeep

# 常见文档格式（万一放在别处也要挡住）
*.pdf
*.ppt
*.pptx
*.doc
*.docx
# ⚠️ 例外：README 里可能引用示意图，用图片格式
!docs/**/*.png
!docs/**/*.svg

# 你从 Canvas 拉下来的课程文件
canvas-out/

# ------------------------------------------------------------
# 2. 🔴 凭证与密钥
# ------------------------------------------------------------
.env
.env.*
!.env.example
*.token
.canvas-token
secrets.json
credentials.json

# ------------------------------------------------------------
# 3. 🔴 数据库与运行时产物（体积大、可重建）
# ------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# 向量缓存 / embedding 缓存
.cache/
embeddings_cache/
*.npy
*.npz
*.faiss
*.index

# 导出与临时产物
out/
output/
*.log
logs/

# ------------------------------------------------------------
# 4. Python
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# 虚拟环境
.venv/
venv/
env/
ENV/
.python-version

# 打包 / 构建
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/
pip-wheel-metadata/

# 测试与覆盖率
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# 类型检查 / lint 缓存
.mypy_cache/
.dmypy.json
.ruff_cache/
.pytype/

# ------------------------------------------------------------
# 5. 编辑器与操作系统
# ------------------------------------------------------------
.vscode/
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
._*

# ------------------------------------------------------------
# 6. 其他
# ------------------------------------------------------------
# Jupyter
.ipynb_checkpoints/

# 临时文件
*.tmp
*.bak
*.orig
*.rej

# 部署相关（若之后加）
.DS_Store
*.pem
