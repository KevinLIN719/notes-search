# 环境变量模板 —— 复制为 .env 并填入真实值
#   cp .env.example .env
#
# ⚠️ .env 已被 .gitignore 排除，不会进仓库。永远不要把真实 key 提交上去。

# ------------------------------------------------------------
# embedding 服务（向量检索用，主体层交付物 #6）
# ------------------------------------------------------------
# 方案 A：OpenAI 兼容接口
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# 方案 B：本地 ollama（免费、离线）
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_API_KEY=ollama
# EMBEDDING_MODEL=nomic-embed-text

# ------------------------------------------------------------
# 存储路径
# ------------------------------------------------------------
# SQLite 索引文件位置（相对仓库根目录）
NOTES_DB_PATH=notes_search.db

# ------------------------------------------------------------
# 检索参数（可选，有默认值）
# ------------------------------------------------------------
DEFAULT_CHUNK_SIZE=400
DEFAULT_OVERLAP=40
DEFAULT_TOP_K=10
